# Placeholder values for local PostgreSQL development and test databases.
DATABASE_URL=postgresql+psycopg://careerai:replace-with-a-local-password@localhost:5433/careerai_dev
TEST_DATABASE_URL=postgresql+psycopg://careerai_test:replace-with-a-local-password@localhost:5434/careerai_test

# Auth secret. Generate a strong value locally and never commit the real one.
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME=CareerAI API
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Keep uploaded resumes outside frontend public/static directories.
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIRECTORY=var/resumes
ALLOWED_RESUME_EXTENSIONS=[".pdf"]
ALLOWED_RESUME_CONTENT_TYPES=["application/pdf"]

# AI is disabled until a local provider/model or cloud provider/secret is configured.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_CHARS=20000

# Local AI (no API key): install Ollama, pull qwen2.5:3b, then set:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
#
# Or use OpenAI with a key kept in your untracked .env:
# LLM_PROVIDER=openai
# LLM_API_KEY=your-local-OpenAI-API-key
# LLM_MODEL=gpt-4o-mini
