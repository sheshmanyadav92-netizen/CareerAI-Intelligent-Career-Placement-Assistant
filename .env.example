# Local PostgreSQL credentials for Docker Compose. Replace the password locally.
POSTGRES_DB=careerai_dev
POSTGRES_USER=careerai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_TEST_DB=careerai_test
POSTGRES_TEST_USER=careerai_test
POSTGRES_TEST_PASSWORD=replace-with-a-local-password

# Keep uploaded resumes outside frontend public/static directories.
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIRECTORY=var/resumes
ALLOWED_RESUME_EXTENSIONS=[".pdf"]
ALLOWED_RESUME_CONTENT_TYPES=["application/pdf"]

# AI is disabled until a provider and model are configured locally.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_CHARS=20000

# Local AI (no API key): install Ollama, pull qwen2.5:3b, then set:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
#
# Or use OpenAI with a key kept in your untracked .env:
# LLM_PROVIDER=openai
# LLM_API_KEY=your-local-OpenAI-API-key
# LLM_MODEL=gpt-4o-mini
